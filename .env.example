# Environment read by iar_cspy.Config.from_env() (and so by the MCP server,
# iar-cspy-mcp, which adds its own MCP_* variables).

# --- Thrift backend connection (direct, only used when registry is not) ---
THRIFT_HOST=127.0.0.1
THRIFT_PORT=9090
THRIFT_TIMEOUT_MS=15000

# --- Thrift IDL locations (optional) ---
# If omitted, the IDL bundled with the iar-cspy package (iar_cspy/idl) is used
# and uses its directory as include path. Only set these for external IDLs.
#THRIFT_FILE=E:\path\to\cspy.thrift
#THRIFT_INCLUDE_DIRS=E:\path\to\thrift\includes

# --- Service Registry resolution (standalone mode) ---
# Recommended with an already-running CSpyServer2 -standalone: set the registry
# port it prints, and the bridge auto-resolves the real service endpoints.
THRIFT_REGISTRY_HOST=127.0.0.1
THRIFT_REGISTRY_PORT=
THRIFT_REGISTRY_SERVICE=debugger

# --- The IAR installation (normally the only path you need) ---
# An IAR installation or build stage, i.e. the directory with common/bin under
# it. Every program the bridge starts is taken from <IAR_INSTALL_PATH>/common/bin:
# CSpyServer2 for the debugger, IarServiceLauncher for the IDE services.
#IAR_INSTALL_PATH=C:\iar\qtarm-10.2.1

# --- Backend mode (default: managed) ---
# managed:    the bridge starts and supervises the backend itself - an
#             IarServiceLauncher hosting the IDE services (ProjectManager,
#             OptionsService) and owning the service registry, plus a
#             CSpyServer2 that joins it. Programs not present there are
#             simply not started.
# standalone: the backend is already running; connect to its registry (see the
#             registry vars above). Use this for a Thrift-enabled iaride or a
#             hand-started IarServiceLauncher/CSpyServer2.
THRIFT_CSPYSERVER_MODE=managed

# --- Individual program paths (override IAR_INSTALL_PATH; rarely needed) ---
#THRIFT_CSPYSERVER_EXE=C:\iar\qtarm-10.2.1\common\bin\CSpyServer2.exe
#THRIFT_SERVICE_LAUNCHER_EXE=C:\iar\qtarm-10.2.1\common\bin\IarServiceLauncher.exe
# Where the service libraries and their JSON manifests live; defaults to
# <IAR_INSTALL_PATH>/common/bin.
#THRIFT_SERVICE_BIN_DIR=C:\iar\qtarm-10.2.1\common\bin
THRIFT_CSPYSERVER_ARGS=-standalone -sockets
THRIFT_CSPYSERVER_START_TIMEOUT_MS=20000
THRIFT_CSPYSERVER_RESTART_ON_FAILURE=1
THRIFT_SERVICE_LAUNCHER_START_TIMEOUT_MS=40000
THRIFT_SERVICE_LAUNCHER_RESTART_ON_FAILURE=1

# --- IDE platform services: ProjectManager + OptionsService ---
# Run the debugger alone, with no IarServiceLauncher: the project_* and
# options_* tools are then unavailable (same as --no-ide-services).
#THRIFT_HOST_IDE_SERVICES=0
# Which IDE services to host: projectmanager, options (default: both).
#THRIFT_IDE_SERVICES=projectmanager,options
# Start a missing IDE service automatically on first project_*/options_* call.
#THRIFT_AUTO_IDE_SERVICES=1
# Registry names to resolve these services under; only needed if a backend
# registers them non-standard.
#THRIFT_PROJECTMANAGER_SERVICE_NAME=com.iar.thrift.service.projectmanager
#THRIFT_OPTIONSSERVICE_SERVICE_NAME=com.iar.optionsservice

# --- Auto-registered handler services (defaults are on) ---
#THRIFT_AUTO_EVENTHANDLER=1
#THRIFT_AUTO_LIBSUPPORT=1
#THRIFT_EVENTHANDLER_CLIENT_TIMEOUT_MS=3600000
#THRIFT_LIBSUPPORT_CLIENT_TIMEOUT_MS=3600000
#THRIFT_LISTWINDOW_CLIENT_TIMEOUT_MS=3600000

