# Reference for the environment variables read by the Python package
# (iar_cspy.launch(), connect() and Config.from_env()), and so also by the MCP
# server (iar-cspy-mcp), which adds its own MCP_* variables.
#
# Nothing loads this file automatically: set the variables in your shell, or
# in the "env" block of your MCP client's server entry. Normally only one is
# needed: IAR_INSTALL_PATH (managed mode) or THRIFT_REGISTRY_PORT (standalone
# mode). Every value shown is the default, or an example path.

# --- The IAR installation (managed mode; normally the only setting) ---
# An IAR installation or build stage, i.e. the directory with common/bin under
# it. Every program started is taken from <IAR_INSTALL_PATH>/common/bin:
# CSpyServer2 for the debugger, IarServiceLauncher for the IDE services.
#IAR_INSTALL_PATH=C:\iar\ewarm-9.60

# --- Backend mode ---
# managed:    start and supervise the backend from IAR_INSTALL_PATH: an
#             IarServiceLauncher hosting the IDE services (ProjectManager,
#             OptionsService) and owning the service registry, plus a
#             CSpyServer2 that joins it. Programs the installation does not
#             ship are not started.
# standalone: the backend is already running (a Thrift-enabled iaride, or a
#             hand-started IarServiceLauncher/CSpyServer2); connect to its
#             service registry, below.
# "external" and "launcher" are accepted as the names these had before.
#THRIFT_CSPYSERVER_MODE=managed

# --- Service registry of a running backend (standalone mode) ---
# The port the backend prints ("Service registry running on local socket on
# port: N"). It is the registry, not the debugger service itself.
#THRIFT_REGISTRY_PORT=51926
#THRIFT_REGISTRY_HOST=127.0.0.1
# Registry name of the debugger service.
#THRIFT_REGISTRY_SERVICE=debugger

# --- Timeouts ---
#THRIFT_TIMEOUT_MS=15000
#THRIFT_CSPYSERVER_START_TIMEOUT_MS=20000
# Higher than CSpyServer2's, because the launcher loads the service libraries.
#THRIFT_SERVICE_LAUNCHER_START_TIMEOUT_MS=40000

# --- Individual program paths (override IAR_INSTALL_PATH; rarely needed) ---
#THRIFT_CSPYSERVER_EXE=C:\iar\ewarm-9.60\common\bin\CSpyServer2.exe
#THRIFT_SERVICE_LAUNCHER_EXE=C:\iar\ewarm-9.60\common\bin\IarServiceLauncher.exe
# Where the service libraries and their JSON manifests live.
#THRIFT_SERVICE_BIN_DIR=<IAR_INSTALL_PATH>/common/bin
# CSpyServer2 arguments when it runs without a launcher. With a launcher it
# always gets -sockets -registry <launcher port>.
#THRIFT_CSPYSERVER_ARGS=-standalone -sockets
# Restart a managed process that fails (retries startup once, too).
#THRIFT_CSPYSERVER_RESTART_ON_FAILURE=1
#THRIFT_SERVICE_LAUNCHER_RESTART_ON_FAILURE=1

# --- IDE platform services: ProjectManager + OptionsService ---
# See docs/ide-services.md.
# 0 runs the debugger alone, with no IarServiceLauncher: the project and
# options features are then unavailable (same as --no-ide-services).
#THRIFT_HOST_IDE_SERVICES=1
# Which IDE services to host: projectmanager, options (default: both).
# options always brings projectmanager along: it needs it in the same process.
#THRIFT_IDE_SERVICES=projectmanager,options
# Start a missing IDE service automatically on first use.
#THRIFT_AUTO_IDE_SERVICES=1
# Registry names to resolve these services under; only needed if a backend
# registers them non-standard.
#THRIFT_PROJECTMANAGER_SERVICE_NAME=com.iar.thrift.service.projectmanager
#THRIFT_OPTIONSSERVICE_SERVICE_NAME=com.iar.optionsservice

# --- Callback services hosted for the backend ---
# The debug event handler and libsupport (the target's terminal I/O).
#THRIFT_AUTO_EVENTHANDLER=1
#THRIFT_AUTO_LIBSUPPORT=1
#THRIFT_EVENTHANDLER_CLIENT_TIMEOUT_MS=3600000
#THRIFT_LIBSUPPORT_CLIENT_TIMEOUT_MS=3600000
#THRIFT_LISTWINDOW_CLIENT_TIMEOUT_MS=3600000

# --- Direct debugger endpoint (only used when there is no registry at all) ---
#THRIFT_HOST=127.0.0.1
#THRIFT_PORT=9090

# --- Thrift IDL (optional) ---
# The IDL bundled with the iar-cspy package is used by default. Only set these
# for an external IDL.
#THRIFT_FILE=C:\path\to\cspy.thrift
#THRIFT_INCLUDE_DIRS=C:\path\to\thrift\includes

